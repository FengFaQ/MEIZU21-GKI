diff --git a/drivers/of/base.c b/drivers/of/base.c
index d5a5c35..e8d277d 100644
--- a/drivers/of/base.c
+++ b/drivers/of/base.c
@@ -168,6 +168,40 @@ void __init of_core_init(void)
 	struct device_node *np;
 
 
+	/* Sanitize Meizu /bootinfo and /chosen/bootargs without writing to RO FDT fixmap */
+	{
+		static u32 mz_zero_val;
+		static __be32 mz_one_val = cpu_to_be32(1);
+		struct device_node *bi = of_find_node_by_path("/bootinfo");
+		if (bi) {
+			struct property *p;
+			p = of_find_property(bi, "bl_unlock", NULL);
+			if (p && p->length >= 4)
+				p->value = &mz_zero_val;
+			p = of_find_property(bi, "lock_flag", NULL);
+			if (p && p->length >= 4)
+				p->value = &mz_one_val;
+			of_node_put(bi);
+		}
+		if (of_chosen) {
+			struct property *ba = of_find_property(of_chosen, "bootargs", NULL);
+			if (ba && ba->value && ba->length > 0) {
+				char *new_ba = kmemdup(ba->value, ba->length, GFP_KERNEL);
+				if (new_ba) {
+					char *pos = strnstr(new_ba, "verify_rpmbkey=-7", ba->length);
+					if (pos)
+						memcpy(pos, "verify_rpmbkey=0 ", 17);
+					ba->value = new_ba;
+				}
+			}
+		}
+		if (saved_command_line) {
+			char *pos = strstr(saved_command_line, "verify_rpmbkey=-7");
+			if (pos)
+				memcpy(pos, "verify_rpmbkey=0 ", 17);
+		}
+	}
+
 	/* Create the kset, and register existing nodes */
 	mutex_lock(&of_mutex);
 	of_kset = kset_create_and_add("devicetree", NULL, firmware_kobj);
