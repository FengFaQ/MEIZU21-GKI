 	return result;
 }
+
+void sysctl_sched_uclamp_get(unsigned int *sched_uclamp_util_min,
+			     unsigned int *sched_uclamp_util_max)
+{
+	if (!sched_uclamp_util_min || !sched_uclamp_util_max)
+		return;
+
+	mutex_lock(&uclamp_mutex);
+	*sched_uclamp_util_min = sysctl_sched_uclamp_util_min;
+	*sched_uclamp_util_max = sysctl_sched_uclamp_util_max;
+	mutex_unlock(&uclamp_mutex);
+}
+
+int sysctl_sched_uclamp_set(unsigned int sched_uclamp_util_min,
+			    unsigned int sched_uclamp_util_max)
+{
+	bool update_root_tg = false;
+	int result = 0;
+
+	mutex_lock(&uclamp_mutex);
+	if (sched_uclamp_util_max > SCHED_CAPACITY_SCALE ||
+	    sched_uclamp_util_min > SCHED_CAPACITY_SCALE ||
+	    sched_uclamp_util_min > sched_uclamp_util_max) {
+		result = -EINVAL;
+		goto done;
+	}
+
+	if (sysctl_sched_uclamp_util_min != sched_uclamp_util_min) {
+		sysctl_sched_uclamp_util_min = sched_uclamp_util_min;
+		uclamp_se_set(&uclamp_default[UCLAMP_MIN],
+			      sched_uclamp_util_min, false);
+		update_root_tg = true;
+	}
+	if (sysctl_sched_uclamp_util_max != sched_uclamp_util_max) {
+		sysctl_sched_uclamp_util_max = sched_uclamp_util_max;
+		uclamp_se_set(&uclamp_default[UCLAMP_MAX],
+			      sched_uclamp_util_max, false);
+		update_root_tg = true;
+	}
+
+	if (update_root_tg) {
+		static_branch_enable(&sched_uclamp_used);
+		uclamp_update_root_tg();
+	}
+done:
+	mutex_unlock(&uclamp_mutex);
+
+	return result;
+}
 #endif
